---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { loadProjectCover } from '../../project-cover';

const categoryLabels = { technical: 'Technical', creative: 'Creative' };
const filters = [{ value: 'all', label: 'All' }, ...Object.entries(categoryLabels).map(([value, label]) => ({ value, label }))];

const editorialOrder = ['portal', 'wifi-transceiver', 'overclock'];
const editorialPosition = (id: string) => {
  const index = editorialOrder.indexOf(id);
  return index === -1 ? editorialOrder.length : index;
};
const projects = (await getCollection('projects')).sort((a, b) =>
  editorialPosition(a.id) - editorialPosition(b.id) || a.data.title.localeCompare(b.data.title, 'en'),
);
const hasDates = projects.some(({ data }) => Boolean(data.date));
const cards = await Promise.all(projects.map(async ({ id, data }) => {
  const cover = await loadProjectCover(data.cover.src);
  const width = Math.min(960, cover.width);
  const widths = [360, 540, 720].filter((candidate) => candidate < width).concat(width);
  return { id, data, cover, width, widths };
}));
---

<SiteLayout title="Work" description="Technical and creative projects by Soren Gabor.">
  <style slot="head" is:global>
    @media (prefers-reduced-motion: no-preference) {
      @view-transition { navigation: auto; }
    }
  </style>
  <section class="container page-section work-library" data-work-library>
    <header class="library-heading">
      <h1 class="page-title">Work</h1>
      <p class="terminal-label" role="status" data-project-status>{cards.length} {cards.length === 1 ? 'project' : 'projects'} shown</p>
    </header>
    <div class="library-controls terminal-panel" data-library-controls hidden>
      <div class="category-filters" role="group" aria-label="Filter projects by category">
        {filters.map(({ value, label }) => (
          <button class="terminal-control" type="button" data-category={value} aria-pressed={value === 'all'}>{label}</button>
        ))}
      </div>
      {hasDates && (
        <label class="project-sort">
          <span class="terminal-label">Sort by</span>
          <select class="terminal-control" data-project-sort>
            <option value="editorial">Portfolio order</option>
            <option value="recent">Most recent</option>
          </select>
        </label>
      )}
    </div>
    <p class="lead" data-empty-projects hidden>No projects in this category yet.</p>
    <ul class="project-grid" role="list" data-project-grid>
      {cards.map(({ id, data, cover, width, widths }, index) => (
        <li data-project-card data-categories={data.categories.join(' ')} data-date={data.date}>
          <a class="project-card terminal-panel" id={`project-${id}`} href={`/work/${id}/`} aria-labelledby={`title-${id}`}>
            <div class="project-media" style={`view-transition-name: cover-${id}`}>
              <Image
                src={cover}
                alt={data.cover.alt}
                width={width}
                widths={widths}
                sizes="(min-width: 88rem) 27rem, (min-width: 70rem) 31vw, (min-width: 45rem) 47vw, 94vw"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </div>
            <div class="project-copy">
              <p class="terminal-label project-discipline">{data.categories.map((category) => categoryLabels[category]).join(' / ')}</p>
              <h2 class="section-title" id={`title-${id}`}>{data.title}</h2>
              <p class="lead">{data.summary}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>

<script>
  interface ProjectReturnState {
    cardId: string;
    scrollY: number;
  }

  const library = document.querySelector<HTMLElement>('[data-work-library]');
  if (library) {
    const controls = library.querySelector<HTMLElement>('[data-library-controls]')!;
    const grid = library.querySelector<HTMLElement>('[data-project-grid]')!;
    const status = library.querySelector<HTMLElement>('[data-project-status]')!;
    const empty = library.querySelector<HTMLElement>('[data-empty-projects]')!;
    const filters = Array.from(controls.querySelectorAll<HTMLButtonElement>('[data-category]'));
    const sort = controls.querySelector<HTMLSelectElement>('[data-project-sort]');
    const editorial = Array.from(grid.querySelectorAll<HTMLElement>('[data-project-card]'));
    const recent = [...editorial].sort((a, b) => (b.dataset.date ?? '').localeCompare(a.dataset.date ?? ''));
    let currentSort = 'editorial';

    function render(url: URL) {
      const requested = url.searchParams.get('category');
      const category = filters.find((filter) => filter.dataset.category === requested)?.dataset.category ?? 'all';
      const order = sort && url.searchParams.get('sort') === 'recent' ? 'recent' : 'editorial';

      for (const filter of filters) {
        filter.setAttribute('aria-pressed', String(filter.dataset.category === category));
      }
      if (sort) sort.value = order;
      if (order !== currentSort) {
        grid.append(...(order === 'recent' ? recent : editorial));
        currentSort = order;
      }

      let visible = 0;
      for (const card of editorial) {
        card.hidden = category !== 'all' && !card.dataset.categories?.split(' ').includes(category);
        if (!card.hidden) visible += 1;
      }

      empty.hidden = visible > 0;
      const result = `${visible} ${visible === 1 ? 'project' : 'projects'} shown`;
      if (status.textContent !== result) status.textContent = result;
    }

    function updateView(key: string, value?: string) {
      const url = new URL(window.location.href);
      if (value) url.searchParams.set(key, value);
      else url.searchParams.delete(key);
      if (url.href === window.location.href) return;

      history.replaceState(history.state, '', url);
      render(url);
    }

    for (const filter of filters) {
      filter.addEventListener('click', () => {
        updateView('category', filter.dataset.category === 'all' ? undefined : filter.dataset.category);
      });
    }
    sort?.addEventListener('change', () => updateView('sort', sort.value === 'recent' ? 'recent' : undefined));

    grid.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const card = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a.project-card') : null;
      if (!card) return;

      const workProjectReturn: ProjectReturnState = { cardId: card.id, scrollY: window.scrollY };
      history.replaceState({ ...history.state, workProjectReturn }, '');
    });

    render(new URL(window.location.href));
    controls.hidden = false;
    window.addEventListener('pageshow', (event) => {
      render(new URL(window.location.href));
      const state: ProjectReturnState | undefined = history.state?.workProjectReturn;
      if (!state) return;
      history.replaceState({ ...history.state, workProjectReturn: undefined }, '');

      const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      if (!event.persisted && navigation?.type !== 'back_forward') return;
      const card = document.getElementById(state.cardId);
      if (!card || !grid.contains(card) || card.closest('[hidden]')) return;

      requestAnimationFrame(() => {
        window.scrollTo({ top: state.scrollY, behavior: 'instant' });
        card.focus({ preventScroll: true });
      });
    });
  }
</script>

<style>
  .work-library {
    padding-block-start: var(--space-4);
  }

  .library-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-2);
  }

  .library-controls:not([hidden]),
  .category-filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .library-controls:not([hidden]) {
    justify-content: space-between;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
    padding: var(--space-1);
  }

  .project-sort {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  [data-empty-projects] {
    margin-block-start: var(--space-3);
  }

  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4) var(--space-3);
    padding: 0;
    margin: var(--space-3) 0 0;
    list-style: none;
  }

  .project-card {
    display: grid;
    align-content: start;
    block-size: 100%;
    color: inherit;
    text-decoration: none;
    transition: border-color var(--motion-fast) var(--ease-out);
  }

  .project-media {
    display: grid;
    place-items: center;
    aspect-ratio: 8 / 5;
    padding: var(--space-1);
    background-color: var(--color-background);
    background-image: radial-gradient(var(--color-rule) 0.5px, transparent 0.5px);
    background-size: 0.5rem 0.5rem;
    border-block-end: 1px solid var(--color-rule);
    border-start-start-radius: var(--panel-radius);
    border-start-end-radius: var(--panel-radius);
    overflow: hidden;
  }

  .project-media img {
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 0;
    object-fit: contain;
  }

  .project-copy {
    padding: var(--space-2);
  }

  .project-copy .section-title {
    font-size: clamp(1.375rem, 1.15rem + 1vw, 2rem);
  }

  .project-discipline {
    margin-block-end: var(--space-1);
  }

  .project-copy .lead {
    margin-block-start: var(--space-1);
  }

  .project-card:is(:focus-visible, :active) {
    border-color: var(--color-accent);
    transition-duration: 0ms;
  }

  .project-card:is(:focus-visible, :active) .section-title {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  @media (hover: hover) {
    .project-card:hover {
      border-color: var(--color-accent);
    }

    .project-card:hover .section-title {
      text-decoration: underline;
      text-underline-offset: 0.22em;
    }
  }

  @media (min-width: 45rem) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 70rem) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
