---
import { Image, getImage } from 'astro:assets';
import widePortrait from '../../../../images/info_splash.jpg';
import portrait from '../../../../images/info_splash_mobile.png';
import SiteLayout from '../../layouts/SiteLayout.astro';

const desktopPortrait = await getImage({
  src: widePortrait,
  width: 1200,
  widths: [720, 960, 1200],
  format: 'webp',
});

const experience = [
  {
    role: 'Embedded Systems Research and Development Intern',
    organization: 'Lockheed Martin Advanced Technology Laboratories',
    period: 'Started 2024',
    summary: 'Embedded systems research and development, including lab automation and hardware testing.',
  },
  {
    role: 'Nuclear Physics Research Assistant',
    organization: 'University of St. Thomas Physics Department',
    period: '2022–2025',
    summary: 'Designed and tested electronics for nuclear physics lab instrumentation.',
  },
  {
    role: 'Freelance Multimedia Designer',
    period: '2022–2024',
  },
];

const awards = [
  { title: 'Board of Governors Summit Scholarship', organization: 'University of St. Thomas Engineering Department' },
  { title: 'Samuel M. Paine Navy V-12 Memorial Scholarship', organization: 'University of St. Thomas Engineering Department' },
  { title: 'Aquinas Honors Scholar', organization: 'University of St. Thomas' },
  { title: 'Book Award for Community Leadership', organization: 'Saint Michael’s College' },
];

const activities = [
  {
    title: 'UST Sailing Team',
    role: 'Competitor and media creator',
    summary: 'Competitor on the University of St. Thomas sailing team, racing dinghies and keelboats at regional and national regattas. Also the team’s content creator and cinematographer.',
    href: 'https://www.ustsailing.org',
    link: 'ustsailing.org',
  },
  {
    title: 'Shredders Club',
    role: 'Founder and president',
    summary: 'Founder and president of the university’s recreational ski and snowboard club, one of the largest student organizations on campus. Leads group trips, volunteering, and community events.',
    href: 'https://www.instagram.com/ust_shredders/',
    link: 'Instagram',
  },
  {
    title: 'Aquinas Honors Scholars',
    role: 'Member',
    summary: 'Interdisciplinary seminars, service projects, and leadership development with a cohort of honors students.',
  },
];

const socials = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/soren-gabor/',
    path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11.25H3V9.75Zm6.5 0h3.84v1.54h.06c.53-1 1.84-2.08 3.79-2.08 4.05 0 4.81 2.67 4.81 6.14V21h-4v-4.9c0-1.17-.02-2.67-1.63-2.67-1.63 0-1.88 1.27-1.88 2.59V21h-4V9.75Z',
  },
  {
    label: 'YouTube',
    href: 'https://www.youtube.com/@soren_air',
    path: 'M21.58 7.2a2.5 2.5 0 0 0-1.76-1.77C18.27 5 12 5 12 5s-6.27 0-7.82.43A2.5 2.5 0 0 0 2.42 7.2C2 8.76 2 12 2 12s0 3.24.42 4.8a2.5 2.5 0 0 0 1.76 1.77C5.73 19 12 19 12 19s6.27 0 7.82-.43a2.5 2.5 0 0 0 1.76-1.77C22 15.24 22 12 22 12s0-3.24-.42-4.8ZM10 15V9l5.2 3-5.2 3Z',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/gaborsoren/',
    path: 'M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-3.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z',
  },
];
---

<SiteLayout title="About" description="About Soren Gabor, with experience in electrical engineering, physics, and multimedia design.">
  <div class="container about">
    <div class="about-intro module-grid">
      <div class="about-bio">
        <h1 class="page-title display-title">ABOUT</h1>
        <p class="bio-opening">Hello, my name is Soren Gabor.</p>
        <p class="lead">I’m currently studying Electrical Engineering and Physics at the University of St. Thomas in St. Paul, Minnesota. While my work often focuses on designing and improving electronic systems, I love creative endeavors of every kind.</p>
        <a class="text-link contact-jump" href="#contact">CONTACT</a>
      </div>
      <picture class="about-portrait bracketed">
        <source media="(min-width: 54rem)" srcset={desktopPortrait.srcSet.attribute} sizes="(min-width: 88rem) 49rem, 56vw" />
        <Image
          src={portrait}
          alt="Soren Gabor in profile in front of a painted brick wall"
          width={800}
          widths={[400, 640, 800, 1076]}
          sizes="100vw"
          loading="eager"
        />
      </picture>
    </div>

    <section class="about-section" aria-labelledby="experience-heading">
      <h2 class="section-title" id="experience-heading">EXPERIENCE</h2>
      <ul class="details-list">
        {experience.map(({ role, organization, period, summary }) => (
          <li class="experience">
            <div>
              <h3>{role}</h3>
              {organization && <p class="lead">{organization}</p>}
              {summary && <p class="experience-summary">{summary}</p>}
            </div>
            <p class="period">{period}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-section" aria-labelledby="awards-heading">
      <h2 class="section-title" id="awards-heading">AWARDS AND RECOGNITION</h2>
      <ul class="details-list">
        {awards.map(({ title, organization }) => (
          <li>
            <h3>{title}</h3>
            <p class="lead">{organization}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="about-section" aria-labelledby="activities-heading">
      <h2 class="section-title" id="activities-heading">ACTIVITIES</h2>
      <ul class="details-list">
        {activities.map(({ title, role, summary, href, link }) => (
          <li>
            <h3>{title}</h3>
            <p class="lead">{role}</p>
            <p class="experience-summary">{summary}</p>
            {href && <a class="text-link" href={href}>{link}</a>}
          </li>
        ))}
      </ul>
    </section>

    <section class="contact bracketed" id="contact" aria-labelledby="contact-heading" tabindex="-1">
      <h2 class="section-title" id="contact-heading">CONTACT</h2>
      <div>
        <a class="text-link contact-email" href="mailto:gaborsoren@gmail.com" data-decode-hover><span>gaborsoren@gmail.com</span></a>
        <ul class="socials">
          {socials.map(({ label, href, path }) => (
            <li>
              <a class="social" href={href} aria-label={label} title={label}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={path} fill="currentColor" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</SiteLayout>

<script>
  // Decode the email address on hover or focus. The real text is always in the HTML.
  const link = document.querySelector<HTMLElement>('[data-decode-hover]');
  const label = link?.querySelector('span');
  if (link && label && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const original = label.textContent ?? '';
    const pool = 'abcdefghijklmnopqrstuvwxyz0123456789';
    let timer = 0;
    const run = () => {
      window.clearInterval(timer);
      const started = performance.now();
      timer = window.setInterval(() => {
        const progress = (performance.now() - started) / 420;
        const settled = Math.floor(progress * original.length);
        label.textContent = [...original].map((c, i) => (i < settled || c === '@' || c === '.' ? c : pool[Math.floor(Math.random() * pool.length)])).join('');
        if (progress >= 1) { window.clearInterval(timer); label.textContent = original; }
      }, 40);
    };
    link.addEventListener('pointerenter', run);
    link.addEventListener('focus', run);
    link.addEventListener('blur', () => { window.clearInterval(timer); label.textContent = original; });
  }
</script>

<style>
  .about {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-5);
  }

  .about-intro,
  .about-section,
  .contact {
    display: grid;
    gap: var(--space-3);
  }

  .about-intro {
    align-items: center;
  }

  .bio-opening {
    margin-block: var(--space-3) var(--space-2);
    font-size: clamp(1.25rem, 1rem + 0.95vw, 1.75rem);
    line-height: 1.35;
  }

  .about-bio .text-link {
    margin-block-start: var(--space-1);
  }

  .about-portrait {
    display: block;
  }

  .about-portrait img {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 38%;
    background: var(--color-surface);
  }

  .about-section {
    border-block-start: 1px solid var(--color-rule);
    padding-block-start: var(--space-3);
  }

  .details-list,
  .socials {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .details-list li + li {
    margin-block-start: var(--space-2);
    padding-block-start: var(--space-2);
    border-block-start: 1px solid var(--color-rule);
  }

  .details-list h3 {
    margin: 0 0 0.2rem;
    font-size: clamp(1.0625rem, 0.98rem + 0.45vw, 1.375rem);
    line-height: 1.3;
  }

  .experience {
    display: grid;
    gap: var(--space-1) var(--space-3);
  }

  .experience-summary {
    margin-block-start: var(--space-1);
    max-inline-size: var(--readable-width);
  }

  .period {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .contact {
    padding: var(--space-3);
    background: var(--color-surface);
    scroll-margin-block-start: var(--space-2);
  }

  .contact:target h2 {
    color: var(--color-accent);
  }

  .contact:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .contact-jump {
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
  }

  /* Terminal hover: the address re-decodes and a block cursor follows it. */
  .contact-email::after {
    content: '';
    display: inline-block;
    inline-size: 0.5em;
    block-size: 0.85em;
    margin-inline-start: 0.12em;
    background: var(--color-accent);
    opacity: 0;
    transform: translateY(0.08em);
  }

  .contact-email:is(:hover, :focus-visible)::after { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .contact-email:is(:hover, :focus-visible)::after { animation: cursor-blink 1s steps(1, end) infinite; }
  }

  @keyframes cursor-blink { 50% { opacity: 0; } }

  .contact-email {
    text-decoration: none;
    max-inline-size: 100%;
    font: 700 clamp(1.25rem, 0.82rem + 2vw, 2.625rem) / 1.15 var(--font-display);
    overflow-wrap: anywhere;
  }

  .social {
    display: grid;
    place-items: center;
    inline-size: var(--tap-target);
    block-size: var(--tap-target);
    border: 1px solid var(--color-control-edge);
    color: var(--color-text);
    transition: background-color var(--motion-fast) var(--ease-out), color var(--motion-fast) var(--ease-out), border-color var(--motion-fast) var(--ease-out);
  }

  .social svg { inline-size: 1.375rem; block-size: 1.375rem; }

  .social:is(:hover, :focus-visible, :active) {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-background);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-block-start: var(--space-2);
  }

  @media (min-width: 38rem) {
    .experience {
      grid-template-columns: minmax(0, 1fr) max-content;
    }
  }

  @media (min-width: 54rem) {
    .about-intro {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    }

    .about-portrait img {
      aspect-ratio: 16 / 10;
      object-position: 33% center;
    }

    .about-section,
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }
  }
</style>
