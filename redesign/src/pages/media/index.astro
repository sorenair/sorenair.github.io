---
import { Image, getImage } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import StatusLine from '../../components/terminal/StatusLine.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import FeaturedCarousel, { type FeaturedItem } from './_FeaturedCarousel.astro';
import { loadProjectCover as loadCover } from '../../project-cover';

const mediaLabels = { video: 'Video', photo: 'Photography', artwork: 'Artwork', youtube: 'YouTube', instagram: 'Instagram' };
const outboundLabels = { youtube: 'Watch on YouTube', instagram: 'View on Instagram' };
const maxFeatured = 5;
/** Work projects whose covers stand in as Featured highlights until enough media is marked `featured`. */
const featuredPlaceholderProjects = ['portal', 'wifi-transceiver', 'overclock', 'nighteye', 'astrogolf'];

// Newest dated items first; undated items keep their file order after them.
const collection = (await getCollection('media')).sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''));
const entries = await Promise.all(collection.map(async ({ id, data }) => {
  if (data.kind === 'video') {
    return { id, kind: data.kind, title: data.title, description: data.description ?? '', src: data.src!, poster: data.poster! };
  }

  const cover = await loadCover(data.cover!.src);
  const width = Math.min(900, cover.width);
  const widths = [360, 540, 720].filter((candidate) => candidate < width).concat(width);
  const entry = { id, kind: data.kind, title: data.title, alt: data.cover!.alt, caption: data.caption, href: data.href, project: data.project, cover, width, widths };
  if (data.kind !== 'photo') return entry;

  const fullPhoto = await getImage({ src: cover, width: Math.min(1600, cover.width), format: 'webp' });
  return { ...entry, fullPhotoHref: fullPhoto.src };
}));
// Highlights are media entries marked `featured`; selected Work covers fill any remaining places.
const featuredMedia: FeaturedItem[] = collection
  .filter(({ data }) => data.featured && data.kind !== 'video' && data.cover)
  .map(({ id, data }) => ({
    id,
    title: data.title,
    label: mediaLabels[data.kind],
    href: `#${id}`,
    coverSrc: data.cover!.src,
    alt: data.cover!.alt,
  }));
const placeholders: FeaturedItem[] = (await Promise.all(
  featuredPlaceholderProjects.map((slug) => getEntry('projects', slug)),
)).flatMap((project) => project ? [{
  id: project.id,
  title: project.data.title,
  label: 'Work',
  href: `/work/${project.id}/`,
  coverSrc: project.data.cover.src,
  alt: project.data.cover.alt,
}] : []);
const highlights = [...featuredMedia, ...placeholders].slice(0, maxFeatured);
---

<SiteLayout title="Media" description="Photography, video, and artwork by Soren Gabor.">
  <div class="page-section media-gallery module-grid">
    <div class="media-top">
      <StatusLine items={[`NODE ${entries.length}`]} />
      <h1 class="display-title" data-reveal>Media</h1>
    </div>
    <FeaturedCarousel items={highlights} />
    <div class="view-toggle" role="group" aria-label="Media view" data-view-toggle hidden>
      <button class="terminal-control" type="button" data-view="explore" aria-pressed="true" aria-controls="media-wall">Explore</button>
      <button class="terminal-control" type="button" data-view="gallery" aria-pressed="false" aria-controls="media-gallery">Gallery</button>
    </div>
    <div class="media-wall" id="media-wall" aria-label="Media library. Drag or use the arrow keys to browse." role="region" hidden>
      {Array.from({ length: 35 }, (_, index) => (
        <a class="wall-tile" data-wall-tile data-row={Math.floor(index / 7) - 2} data-column={index % 7 - 3} tabindex="-1"></a>
      ))}
    </div>
    <ul class="media-grid" id="media-gallery" aria-label="Media library" role="list">
      {entries.map((entry) => (
        <li class="media-entry" id={entry.id} tabindex="-1">
          <figure>
            <div class="media-visual bracketed">
              {entry.kind === 'video' ? (
                <video
                  controls
                  playsinline
                  preload="none"
                  poster={entry.poster}
                  width="1280"
                  height="720"
                  aria-labelledby={`title-${entry.id}`}
                  aria-describedby={`description-${entry.id}`}
                >
                  <source src={entry.src} type="video/mp4" />
                  <a href={entry.src}>Open the reel</a>
                </video>
              ) : (
                <Image
                  src={entry.cover}
                  alt={entry.alt}
                  width={entry.width}
                  widths={entry.widths}
                  sizes="(min-width: 64rem) 34vw, (min-width: 38rem) 50vw, 100vw"
                />
              )}
            </div>
            <figcaption>
              <p class="terminal-label">{mediaLabels[entry.kind]}</p>
              <h2 class="section-title" id={`title-${entry.id}`} tabindex="-1">{entry.title}</h2>
              {entry.kind === 'video' && <p class="lead" id={`description-${entry.id}`}>{entry.description}</p>}
              {entry.kind !== 'video' && entry.caption && <p class="lead">{entry.caption}</p>}
              {entry.kind === 'photo' && (
                <a class="text-link" href={entry.fullPhotoHref} aria-label={`View the full photo, ${entry.title}`}>View full photo</a>
              )}
              {(entry.kind === 'youtube' || entry.kind === 'instagram') && entry.href && (
                <a class="text-link" href={entry.href} rel="noopener" aria-label={`${outboundLabels[entry.kind]}: ${entry.title}`}>{outboundLabels[entry.kind]}</a>
              )}
              {entry.kind === 'artwork' && entry.project && (
                <a class="text-link" href={`/work/${entry.project}/`} aria-label={`View the project, ${entry.title}`}>View project</a>
              )}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <dialog class="media-detail terminal-panel" id="media-detail" aria-label="Media item">
      <form method="dialog"><button class="terminal-control">Close</button></form>
      <div data-media-detail></div>
    </dialog>
  </div>
</SiteLayout>

<script>
  const wall = document.querySelector<HTMLElement>('#media-wall');
  const gallery = document.querySelector<HTMLElement>('#media-gallery');
  const dialog = document.querySelector<HTMLDialogElement>('#media-detail');
  const detail = dialog?.querySelector('[data-media-detail]');

  if (wall && gallery && dialog && detail && typeof dialog.showModal === 'function') {
    const entries = [...gallery.querySelectorAll<HTMLElement>('.media-entry')].map((entry) => ({
      entry,
      figure: entry.querySelector('figure')!,
      title: entry.querySelector('h2')!.textContent!,
      image: entry.querySelector('video')?.poster ?? entry.querySelector('img')!.src,
    }));
    const tiles = [...wall.querySelectorAll<HTMLAnchorElement>('[data-wall-tile]')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let originX = 0;
    let originY = 0;
    let stepX = 0;
    let stepY = 0;
    let drag: { x: number; y: number; id: number } | undefined;
    let dragged = false;
    let opened: typeof entries[number] | undefined;

    function draw(dx = 0, dy = 0) {
      if (!wall || wall.hidden) return;
      const width = wall.clientWidth;
      const height = wall.clientHeight;
      stepX = Math.max(116, width / (width < 600 ? 2.65 : 4.7));
      stepY = height / 2.65;
      const shiftX = Math.round(dx / stepX);
      const shiftY = Math.round(dy / stepY);
      for (const tile of tiles) {
        const column = Number(tile.dataset.column);
        const row = Number(tile.dataset.row);
        const x = (column - shiftX) * stepX + dx;
        const y = (row - shiftY) * stepY + dy;
        const horizontalBend = Math.max(-1, Math.min(1, x / (width / 2)));
        const verticalBend = Math.max(-1, Math.min(1, y / (height / 2)));
        const offset = originX + column - shiftX + 2 * (originY + row - shiftY);
        const item = entries[((offset % entries.length) + entries.length) % entries.length];
        tile.style.width = `${stepX - 8}px`;
        tile.style.height = `${stepY - 8}px`;
        tile.style.transform = `translate(-50%, -50%) translate(${x}px, ${y}px) rotateY(${-horizontalBend * 24}deg) rotateX(${verticalBend * 20}deg) scale(${1 - Math.min(0.2, Math.hypot(horizontalBend, verticalBend) * 0.13)})`;
        tile.style.backgroundImage = `url("${item.image}")`;
        tile.href = `#${item.entry.id}`;
        tile.setAttribute('aria-label', item.title);
        tile.tabIndex = row === 0 && column >= 0 && column < entries.length && (width >= 600 || column === 0) ? 0 : -1;
      }
    }

    function openItem(id: string) {
      if (!dialog || !detail) return;
      opened = entries.find(({ entry }) => `#${entry.id}` === id);
      if (!opened) return;
      detail.append(opened.figure);
      dialog.setAttribute('aria-label', opened.title);
      dialog.showModal();
    }

    dialog.addEventListener('close', () => {
      opened?.figure.querySelector('video')?.pause();
      if (opened) opened.entry.append(opened.figure);
      opened = undefined;
    });

    for (const link of [...tiles, ...document.querySelectorAll<HTMLAnchorElement>('.featured-tile')]) {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (!link.hash || link.pathname !== location.pathname) return;
        event.preventDefault();
        if (!wall.contains(link) || !dragged) openItem(link.hash);
      });
    }

    // The wall keeps one continuous offset. Dragging moves it directly; on release it eases to the
    // nearest tile, and only then is the move committed to the tile origin (the layout repeats, so
    // committing at a whole tile does not change what is on screen).
    let offsetX = 0;
    let offsetY = 0;
    let settling = 0;

    function commit() {
      const cellsX = Math.round(offsetX / stepX);
      const cellsY = Math.round(offsetY / stepY);
      originX -= cellsX;
      originY -= cellsY;
      offsetX -= cellsX * stepX;
      offsetY -= cellsY * stepY;
    }

    function settleTo(cellsX: number, cellsY: number) {
      cancelAnimationFrame(settling);
      commit();
      const targetX = cellsX * stepX;
      const targetY = cellsY * stepY;
      const fromX = offsetX;
      const fromY = offsetY;
      if (reduced.matches || (fromX === targetX && fromY === targetY)) {
        offsetX = targetX;
        offsetY = targetY;
        commit();
        draw(offsetX, offsetY);
        return;
      }
      const distance = Math.hypot(targetX - fromX, targetY - fromY);
      const duration = Math.min(900, 420 + distance * 0.6);
      const start = performance.now();
      const step = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - (1 - progress) ** 4;
        offsetX = fromX + (targetX - fromX) * eased;
        offsetY = fromY + (targetY - fromY) * eased;
        draw(offsetX, offsetY);
        if (progress < 1) settling = requestAnimationFrame(step);
        else {
          commit();
          draw(offsetX, offsetY);
        }
      };
      settling = requestAnimationFrame(step);
    }

    wall.addEventListener('keydown', (event) => {
      const direction: Record<string, [number, number]> = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
      const step = direction[event.key];
      if (!step) return;
      event.preventDefault();
      // Ease one tile in the arrow's direction; the move is committed when it comes to rest.
      settleTo(-step[0], -step[1]);
    });

    let velocity = { x: 0, y: 0 };
    let last = { x: 0, y: 0, time: 0 };
    let startOffset = { x: 0, y: 0 };

    wall.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary || event.button !== 0) return;
      cancelAnimationFrame(settling);
      dragged = false;
      startOffset = { x: offsetX, y: offsetY };
      velocity = { x: 0, y: 0 };
      last = { x: event.clientX, y: event.clientY, time: event.timeStamp };
      drag = { x: event.clientX, y: event.clientY, id: event.pointerId };
    });
    wall.addEventListener('pointermove', (event) => {
      if (drag?.id !== event.pointerId) return;
      const x = event.clientX - drag.x;
      const y = event.clientY - drag.y;
      if (Math.hypot(x, y) < 8 && !dragged) return;
      if (!dragged) wall.setPointerCapture(event.pointerId);
      dragged = true;
      const elapsed = Math.max(1, event.timeStamp - last.time);
      velocity = {
        x: 0.75 * velocity.x + 0.25 * ((event.clientX - last.x) / elapsed),
        y: 0.75 * velocity.y + 0.25 * ((event.clientY - last.y) / elapsed),
      };
      last = { x: event.clientX, y: event.clientY, time: event.timeStamp };
      if (!reduced.matches) {
        offsetX = startOffset.x + x;
        offsetY = startOffset.y + y;
        draw(offsetX, offsetY);
      }
    });
    wall.addEventListener('pointerup', (event) => {
      if (drag?.id !== event.pointerId) return;
      const x = event.clientX - drag.x;
      const y = event.clientY - drag.y;
      drag = undefined;
      if (!dragged) return;
      // Carry some of the release velocity, then lock onto a tile (at most two tiles of throw).
      const throwX = reduced.matches ? 0 : Math.max(-2 * stepX, Math.min(2 * stepX, velocity.x * 180));
      const throwY = reduced.matches ? 0 : Math.max(-2 * stepY, Math.min(2 * stepY, velocity.y * 180));
      const currentX = reduced.matches ? x : offsetX;
      const currentY = reduced.matches ? y : offsetY;
      if (reduced.matches) {
        offsetX = currentX;
        offsetY = currentY;
      }
      settleTo(Math.round((currentX + throwX) / stepX), Math.round((currentY + throwY) / stepY));
      setTimeout(() => { dragged = false; }, 0);
    });
    wall.addEventListener('pointercancel', () => {
      drag = undefined;
      dragged = false;
      settleTo(Math.round(offsetX / stepX), Math.round(offsetY / stepY));
    });
    wall.addEventListener('dragstart', (event) => event.preventDefault());
    const toggle = document.querySelector<HTMLElement>('[data-view-toggle]');
    function setView(view: 'explore' | 'gallery') {
      wall!.hidden = view !== 'explore';
      gallery!.hidden = view !== 'gallery';
      toggle?.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.view === view));
      });
      if (view === 'explore') draw(offsetX, offsetY);
    }
    toggle?.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-view]');
      if (button) setView(button.dataset.view === 'gallery' ? 'gallery' : 'explore');
    });
    if (toggle) toggle.hidden = false;
    setView(reduced.matches ? 'gallery' : 'explore');
    new ResizeObserver(() => draw(offsetX, offsetY)).observe(wall);
    if (location.hash) openItem(location.hash);
  }
</script>

<style>
  .media-wall {
    position: relative;
    height: clamp(26rem, 72svh, 56rem);
    margin-block-start: var(--space-3);
    overflow: hidden;
    perspective: 54rem;
    touch-action: pan-y pinch-zoom;
    cursor: grab;
    background: var(--color-background);
  }

  .media-wall:active { cursor: grabbing; }

  .wall-tile {
    position: absolute;
    inset: 50% auto auto 50%;
    background: var(--color-surface) center / cover no-repeat;
    cursor: inherit;
  }

  .wall-tile:hover { box-shadow: inset 0 0 0 2px var(--color-accent); }

  .media-detail {
    width: min(92vw, 64rem);
    max-height: 90svh;
    padding: var(--space-2);
    color: var(--color-text);
  }

  .media-detail::backdrop { background: #000c; }
  .media-detail form { margin-block-end: var(--space-2); text-align: end; }
  .media-detail .media-visual { max-height: 65svh; }
  .media-grid[hidden] { display: none; }
  .view-toggle:not([hidden]) {
    display: flex;
    gap: var(--space-1);
    margin: var(--space-3) var(--gutter) 0;
  }

  .media-gallery {
    padding-block-start: var(--space-4);
  }

  .media-top {
    display: grid;
    gap: var(--space-2);
    margin-inline: var(--gutter);
  }

  .media-grid {
    display: grid;
    gap: 1px;
    padding: 0;
    list-style: none;
    background: var(--color-rule);
  }

  .media-entry:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -3px;
  }

  .media-grid {
    grid-template-columns: minmax(0, 1fr);
    margin: var(--space-4) 0 0;
    border-block: 1px solid var(--color-rule);
  }

  .media-entry {
    background: var(--color-background);
  }

  figure {
    margin: 0;
  }

  .media-visual {
    display: grid;
    place-items: center;
    aspect-ratio: 8 / 5;
    background: var(--color-surface);
    overflow: hidden;
  }

  .media-visual :is(img, video) {
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 0;
    object-fit: contain;
  }

  .media-visual video {
    background: var(--color-background);
  }

  .media-visual video:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .media-visual video a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Native video controls take focus inside the shadow tree, so mark the frame. */
  .media-visual:has(video):focus-within {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  figcaption {
    padding: var(--space-2) var(--gutter);
  }

  figcaption .terminal-label {
    margin-block-end: 0.25rem;
  }

  figcaption .section-title {
    font-family: var(--font-display);
    letter-spacing: -0.05em;
    margin-block-start: var(--space-1);
    font-size: clamp(1.375rem, 1.15rem + 1vw, 2rem);
  }

  figcaption .section-title:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  figcaption .lead {
    margin-block-start: var(--space-1);
  }

  @media (min-width: 38rem) {
    .media-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }

  @media (min-width: 64rem) {
    .media-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
