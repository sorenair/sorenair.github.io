---
import { Image } from 'astro:assets';
import { getCoverAccent } from '../../cover-accent';
import { loadProjectCover } from '../../project-cover';

/** One highlight. `href` is a Work page or a `#media-id` that opens the Media dialog. */
export interface FeaturedItem {
  id: string;
  title: string;
  label: string;
  href: string;
  coverSrc: string;
  alt: string;
}

interface Props {
  items: FeaturedItem[];
}

const { items } = Astro.props;
const slides = await Promise.all(items.map(async (item) => {
  const cover = await loadProjectCover(item.coverSrc);
  const width = Math.min(960, cover.width);
  const widths = [480, 720].filter((candidate) => candidate < width).concat(width);
  return { ...item, cover, width, widths, accent: await getCoverAccent(item.coverSrc) };
}));
---

<section class="featured-media" aria-roledescription="carousel" aria-labelledby="featured-media-title" data-carousel>
  <div class="featured-header">
    <h2 class="terminal-label" id="featured-media-title">Featured</h2>
    <div class="carousel-controls" data-carousel-controls hidden>
      <button class="terminal-control chevron" type="button" data-carousel-step="-1" aria-label="Previous highlight">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M10.5 2.5 5 8l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"/></svg>
      </button>
      <span class="carousel-status" role="status" data-carousel-status></span>
      <button class="terminal-control chevron" type="button" data-carousel-step="1" aria-label="Next highlight">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M5.5 2.5 11 8l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"/></svg>
      </button>
    </div>
  </div>
  <ul class="carousel-track" role="list" data-carousel-track>
    {slides.map((slide, index) => (
      <li class="carousel-slide" data-carousel-slide data-accent={slide.accent} aria-roledescription="slide" aria-label={`${index + 1} of ${slides.length}`}>
        <a class="featured-tile carousel-card" href={slide.href}>
          <Image
            src={slide.cover}
            alt={slide.alt}
            width={slide.width}
            widths={slide.widths}
            sizes="(min-width: 60rem) 34rem, 80vw"
            loading={index < 2 ? 'eager' : 'lazy'}
            draggable="false"
          />
          <span class="carousel-caption">
            <span class="terminal-label">{slide.label}</span>
            <span class="carousel-title">{slide.title}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <div class="lens-stage" data-lens-stage hidden>
    <div class="lens-mount" data-lens-mount role="group" aria-label="Featured highlights. Drag sideways or use Previous and Next."></div>
    <a class="lens-link terminal-control" href="#" data-lens-link></a>
  </div>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  const track = carousel?.querySelector<HTMLElement>('[data-carousel-track]');
  if (carousel && track) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const status = carousel.querySelector<HTMLElement>('[data-carousel-status]')!;
    const controls = carousel.querySelector<HTMLElement>('[data-carousel-controls]')!;
    const buttons = Array.from(controls.querySelectorAll<HTMLButtonElement>('[data-carousel-step]'));
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const root = document.documentElement;

    const stage = carousel.querySelector<HTMLElement>('[data-lens-stage]')!;
    const mount = carousel.querySelector<HTMLElement>('[data-lens-mount]')!;
    const lensLink = carousel.querySelector<HTMLAnchorElement>('[data-lens-link]')!;
    lensLink.addEventListener('click', (event) => {
      // Media entries open in the page dialog; the carousel card carries that behaviour.
      if (!lensLink.getAttribute('href')?.startsWith('#') || active < 0) return;
      event.preventDefault();
      slides[active].querySelector<HTMLAnchorElement>('a.carousel-card')?.click();
    });
    let active = -1;
    let frame = 0;
    let settleTimer = 0;
    let glide = 0;

    const centerOf = (slide: HTMLElement) => slide.offsetLeft + slide.offsetWidth / 2;
    const nearest = (position = track.scrollLeft + track.clientWidth / 2) => {
      let best = 0;
      slides.forEach((slide, index) => {
        if (Math.abs(centerOf(slide) - position) < Math.abs(centerOf(slides[best]) - position)) best = index;
      });
      return best;
    };
    const scrollTarget = (index: number) => centerOf(slides[index]) - track.clientWidth / 2;

    // Depth: scale, tilt, and fade follow each slide's distance from the center.
    function paint() {
      frame = 0;
      const middle = track.scrollLeft + track.clientWidth / 2;
      for (const slide of slides) {
        const distance = Math.max(-1, Math.min(1, (centerOf(slide) - middle) / (slide.offsetWidth * 1.1)));
        slide.style.setProperty('--depth', reduced.matches ? '0' : String(distance));
      }
    }

    function settle(forced?: number) {
      const index = typeof forced === 'number' ? forced : nearest();
      if (index === active) return;
      active = index;
      slides.forEach((slide, position) => {
        if (position === index) slide.setAttribute('aria-current', 'true');
        else slide.removeAttribute('aria-current');
      });
      const accent = slides[index].dataset.accent;
      if (accent) root.style.setProperty('--color-active-accent', accent);
      else root.style.removeProperty('--color-active-accent');
      status.textContent = `${index + 1} / ${slides.length}`;
      const link = slides[index].querySelector<HTMLAnchorElement>('a.carousel-card')!;
      if (lensLink) {
        lensLink.href = link.getAttribute('href') ?? '#';
        lensLink.textContent = `View ${slides[index].querySelector('.carousel-title')?.textContent ?? ''}`;
      }
      // The glass row wraps around, so only the plain scroller has ends.
      buttons[0].disabled = !lens && index === 0;
      buttons[1].disabled = !lens && index === slides.length - 1;
    }

    function onScroll() {
      if (!frame) frame = requestAnimationFrame(paint);
      clearTimeout(settleTimer);
      settleTimer = window.setTimeout(settle, 90);
    }

    // Weighted glide used after a mouse drag. Touch keeps the browser's own momentum and scroll snap.
    function glideTo(left: number) {
      cancelAnimationFrame(glide);
      const maxLeft = track.scrollWidth - track.clientWidth;
      const target = Math.max(0, Math.min(maxLeft, left));
      if (reduced.matches) {
        track.scrollLeft = target;
        track.classList.remove('is-dragging');
        return;
      }
      const from = track.scrollLeft;
      const duration = 380 + Math.min(420, Math.abs(target - from) * 0.45);
      const start = performance.now();
      const step = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);
        track.scrollLeft = from + (target - from) * (1 - (1 - progress) ** 4);
        if (progress < 1) glide = requestAnimationFrame(step);
        else track.classList.remove('is-dragging');
      };
      glide = requestAnimationFrame(step);
    }

    function goTo(index: number) {
      const next = Math.max(0, Math.min(slides.length - 1, index));
      track.classList.add('is-dragging');
      glideTo(scrollTarget(next));
    }

    let lens: { step(delta: number): void; goTo(index: number): void; destroy(): void } | undefined;
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const delta = Number(button.dataset.carouselStep);
        if (lens) lens.step(delta);
        else goTo((active < 0 ? 0 : active) + delta);
      });
    }

    let drag: { id: number; x: number; left: number; lastX: number; lastTime: number; velocity: number } | undefined;
    let moved = false;

    track.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;
      cancelAnimationFrame(glide);
      drag = { id: event.pointerId, x: event.clientX, left: track.scrollLeft, lastX: event.clientX, lastTime: event.timeStamp, velocity: 0 };
      moved = false;
    });
    track.addEventListener('pointermove', (event) => {
      if (!drag || drag.id !== event.pointerId) return;
      const delta = event.clientX - drag.x;
      if (!moved && Math.abs(delta) < 6) return;
      if (!moved) {
        moved = true;
        track.classList.add('is-dragging');
        track.setPointerCapture(event.pointerId);
      }
      const elapsed = Math.max(1, event.timeStamp - drag.lastTime);
      drag.velocity = 0.8 * drag.velocity + 0.2 * ((drag.lastX - event.clientX) / elapsed);
      drag.lastX = event.clientX;
      drag.lastTime = event.timeStamp;
      track.scrollLeft = drag.left - delta;
    });
    const release = (event: PointerEvent) => {
      if (!drag || drag.id !== event.pointerId) return;
      const { velocity } = drag;
      drag = undefined;
      if (!moved) return;
      // Project the throw forward, then lock on the nearest slide.
      const projected = track.scrollLeft + track.clientWidth / 2 + velocity * 260;
      glideTo(scrollTarget(nearest(projected)));
      setTimeout(() => { moved = false; }, 0);
    };
    track.addEventListener('pointerup', release);
    track.addEventListener('pointercancel', release);
    track.addEventListener('click', (event) => { if (moved) event.preventDefault(); }, true);
    track.addEventListener('dragstart', (event) => event.preventDefault());

    track.addEventListener('scroll', onScroll, { passive: true });
    track.addEventListener('scrollend', settle);
    addEventListener('resize', () => { paint(); settle(); });
    reduced.addEventListener('change', paint);

    // The WebGL liquid glass row replaces the scroller when the device can run it. The scroller
    // above stays as the fallback for reduced motion, small screens, and failed WebGL.
    async function enableLens() {
      const canvas = document.createElement('canvas');
      const gl = canvas.getContext('webgl2') ?? canvas.getContext('webgl');
      if (!gl || reduced.matches) return;

      const [{ createCarousel }, { CONFIG, ENTRY, LENS }] = await Promise.all([
        import('../../media-lens/engine.js'),
        import('../../media-lens/config.js'),
      ]);
      carousel!.classList.add('is-lens');
      stage.hidden = false;
      // Panels are about 16:9; keep neighbours peeking in on narrow screens.
      CONFIG.PANEL_H = Math.round(Math.min(mount.clientHeight * 0.62, (mount.clientWidth * 0.78) / 1.78));
      ENTRY.enabled = false;
      // Oversized oval: its edge sits outside the frame, so only the outermost panels bend.
      LENS.sizeX = 1.9;
      LENS.sizeY = 1.5;
      LENS.rotation = 10;
      LENS.rimStart = 0.45;
      LENS.rimTangential = 1;
      LENS.whiteGlow = 0;
      LENS.blueColor = '#ffffff';
      LENS.blueRing = 1.2;
      const items = slides.map((slide) => {
        const image = slide.querySelector('img')!;
        return { src: image.currentSrc || image.src, aspect: null };
      });
      let settleDelay = 0;
      let framed = -1;
      let frameTimer = 0;
      // Subtle white frame on the centered item: the one that opens on tap.
      const outline = document.createElement('div');
      outline.className = 'lens-outline';
      outline.setAttribute('aria-hidden', 'true');
      mount.append(outline);
      try {
        const engine = createCarousel(mount, {
          items,
          background: 0x121212,
          onActiveChange: (index: number) => {
            clearTimeout(settleDelay);
            settleDelay = window.setTimeout(() => settle(index), 140);
          },
          onCenterRect: (rect: { left: number; top: number; width: number; height: number; srcIndex: number } | null) => {
            if (!rect) {
              outline.classList.remove('is-on');
              framed = -1;
              return;
            }
            if (rect.srcIndex !== framed) {
              // A new item reached the middle: let the frame ease out, then shrink back in.
              framed = rect.srcIndex;
              outline.classList.remove('is-on');
              clearTimeout(frameTimer);
              frameTimer = window.setTimeout(() => outline.classList.add('is-on'), 180);
            }
            outline.style.transform = `translate(${rect.left}px, ${rect.top}px)`;
            outline.style.width = `${rect.width}px`;
            outline.style.height = `${rect.height}px`;
          },
          onSelect: (index: number) => slides[index].querySelector<HTMLAnchorElement>('a.carousel-card')?.click(),
        });
        lens = engine;
        // Let a vertical swipe scroll the page; horizontal drags still reach the engine.
        mount.querySelector('canvas')?.style.setProperty('touch-action', 'pan-y');
        active = -1;
        settle(0);
      } catch {
        carousel!.classList.remove('is-lens');
        stage.hidden = true;
        lens = undefined;
      }
    }
    enableLens().catch(() => {
      carousel.classList.remove('is-lens');
      stage.hidden = true;
      lens = undefined;
    });

    controls.hidden = false;
    // Start on the first slide centered; the track padding lets edge slides reach the middle.
    track.scrollLeft = scrollTarget(0);
    paint();
    settle();
  }
</script>

<style>
  .featured-media {
    margin-block-start: var(--space-3);
  }

  .featured-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-inline: var(--gutter);
  }

  .carousel-controls:not([hidden]) {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .carousel-controls .chevron {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
  }

  .carousel-controls .carousel-status {
    min-inline-size: 4.5rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .carousel-controls button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .carousel-track {
    --slide-width: clamp(15rem, 62vw, 34rem);
    display: flex;
    gap: var(--space-2);
    margin: var(--space-1) 0 0;
    padding: var(--space-2) calc(50% - var(--slide-width) / 2);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
    perspective: 70rem;
    cursor: grab;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  /* Mouse drags and glides position the track directly, so snapping waits until they finish. */
  .carousel-track.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
  }

  .carousel-slide {
    flex: 0 0 var(--slide-width);
    scroll-snap-align: center;
    scroll-snap-stop: always;
    --depth: 0;
    transform: rotateY(calc(var(--depth) * -16deg)) scale(calc(1 - var(--depth) * var(--depth) * 0.1 - 0.04 * var(--depth) * var(--depth)));
    opacity: calc(1 - 0.35 * var(--depth) * var(--depth));
  }

  .carousel-card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: var(--panel-radius);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    isolation: isolate;
    transition: border-color var(--motion-fast) var(--ease-out);
  }

  .carousel-card img {
    position: absolute;
    inset: 0;
    z-index: -1;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    user-select: none;
  }

  /* A frosted band gives the glass feel; the title stays readable at rest. */
  .carousel-caption {
    position: absolute;
    inset: auto 0.5rem 0.5rem;
    display: grid;
    gap: 0.125rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid #ffffff2e;
    background: #12121299;
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
  }

  .carousel-title {
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem);
    font-weight: 700;
  }

  .carousel-slide[aria-current="true"] .carousel-card {
    border-color: var(--color-accent);
  }

  .carousel-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .carousel-card:hover .carousel-title {
      text-decoration: underline;
      text-underline-offset: 0.22em;
    }
  }

  .lens-stage:not([hidden]) {
    display: grid;
    gap: var(--space-1);
    margin-block-start: var(--space-1);
  }

  .lens-mount {
    position: relative;
    block-size: clamp(15rem, 40vw, 34rem);
    overflow: hidden;
    background: transparent;
    cursor: grab;
    touch-action: pan-y;
  }

  .lens-mount :global(.lens-outline) {
    position: absolute;
    inset: 0 auto auto 0;
    box-sizing: border-box;
    border: 3px solid rgb(255 255 255 / 0.85);
    pointer-events: none;
    opacity: 0;
    scale: 1.06;
    transition: opacity 260ms var(--ease-artifact), scale 260ms var(--ease-artifact);
  }

  .lens-mount :global(.lens-outline.is-on) {
    opacity: 1;
    scale: 1;
  }

  .lens-mount :global(canvas) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  /* Kept for keyboard and screen-reader users; hidden visually. */
  .lens-link {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .is-lens .carousel-track {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-slide {
      transform: none;
      opacity: 1;
    }
  }
</style>
