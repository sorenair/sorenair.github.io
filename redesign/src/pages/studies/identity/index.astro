---
import SiteLayout from '../../../layouts/SiteLayout.astro';
const directions = [
  { id: 'instrument', n: '01', name: 'Instrument', note: 'Precise lab readout. Grotesk headlines, mono data, corner brackets, quiet grain. Closest to the current shell.' },
  { id: 'signal', n: '02', name: 'Signal', note: 'Phosphor terminal. All mono, scanlines and CRT on media, stepped typing reveal, glowing accent.' },
  { id: 'artifact', n: '03', name: 'Artifact', note: 'Monolithic object. Oversized type on a visible Ø grid, the accent floods the active row.' },
];
---

<SiteLayout title="Identity study" description="Visual identity direction study.">
  <meta slot="head" name="robots" content="noindex" />
  <section class="container page-section">
    <p class="terminal-label">Study / visual identity</p>
    <h1 class="page-title">Three directions</h1>
    <p class="lead">Each direction uses the same real content: a type system, an Ø-based grid, status lines and counters, one reveal, one glitch, texture, an interactive ASCII Ø and a Work index with hover preview where the accent follows the active project.</p>
    <ul role="list" style="list-style:none;padding:0;margin:var(--space-4) 0 0;display:grid;gap:var(--space-2)">
      {directions.map(({ id, n, name, note }) => (
        <li class="terminal-panel" style="padding:var(--space-3)">
          <a class="section-title text-link" href={`/studies/identity/${id}/`}>{n} {name}</a>
          <p class="lead">{note}</p>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>
