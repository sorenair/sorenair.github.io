---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/martian-mono';
import SiteLayout from '../../../layouts/SiteLayout.astro';

const options = [
  {
    id: 'current', name: 'Current (system stacks)',
    display: `'Helvetica Neue', Arial, sans-serif`, body: `system-ui, -apple-system, BlinkMacSystemFont, sans-serif`, mono: `ui-monospace, 'SFMono-Regular', Consolas, monospace`,
    note: 'Helvetica Neue / system-ui / system mono. Zero download, but looks different on every device (Helvetica on Mac, Arial or Liberation on Windows and Linux).',
    stretch: '100%', hs: 21,
  },
  {
    id: 'a', name: 'A. Space Grotesk + JetBrains Mono',
    display: `'Space Grotesk Variable', sans-serif`, body: `'Space Grotesk Variable', sans-serif`, mono: `'JetBrains Mono Variable', monospace`,
    note: 'Geometric grotesk with quirky, technical details that suit oversized headlines. Most character of the set.',
    stretch: '100%', hs: 21,
  },
  {
    id: 'b', name: 'B. Inter + IBM Plex Mono',
    display: `'Inter Variable', sans-serif`, body: `'Inter Variable', sans-serif`, mono: `'IBM Plex Mono', monospace`,
    note: 'Neutral and precise like the current look, but consistent on every device. Plex Mono adds a lab-instrument voice.',
    stretch: '100%', hs: 21,
  },
  {
    id: 'c', name: 'C. Geist + Geist Mono',
    display: `'Geist Variable', sans-serif`, body: `'Geist Variable', sans-serif`, mono: `'Geist Mono Variable', monospace`,
    note: 'Swiss-modern and tightly matched sans and mono. Clean at huge sizes and tiny labels.',
    stretch: '100%', hs: 19,
  },
  {
    id: 'd', name: 'D. Archivo (wide) + Inter + Martian Mono',
    display: `'Archivo Variable', sans-serif`, body: `'Inter Variable', sans-serif`, mono: `'Martian Mono Variable', monospace`,
    note: 'Extended-width display makes oversized uppercase feel like machined signage. Martian Mono is wide and futuristic.',
    stretch: '118%', hs: 15,
  },
];

const row = { n: '01', title: 'PØRTAL', context: 'Personal project', cat: 'Technical / Creative' };
const copy = 'I’m currently studying Electrical Engineering and Physics at the University of St. Thomas in St. Paul, Minnesota. While my work often focuses on designing and improving electronic systems, I love creative endeavors of every kind.';
---

<SiteLayout title="Type study" description="Typeface pairing study.">
  <meta slot="head" name="robots" content="noindex" />
  <section class="container page-section">
    <p class="terminal-label">Study / type</p>
    <h1 class="page-title" data-fit>Type pairings</h1>
    <p class="lead">Each panel shows the Home hero title, a Work row and body copy with a different display, body and mono pairing. All options are free and self-hosted, so they look the same on every device.</p>
    <div class="grid">
      {options.map(({ id, name, display, body, mono, note, stretch, hs }) => (
        <article class="panel terminal-panel" style={`--fd:${display};--fb:${body};--fm:${mono};--fw:${stretch};--hs:${hs}`}>
          <h2 class="name">{name}</h2>
          <p class="note">{note}</p>
          <p class="hero" data-no-reveal>SOREN GABOR</p>
          <div class="work">
            <span class="mono">{row.n}</span>
            <span class="title">{row.title}</span>
            <span class="mono ctx">{row.context}</span>
            <span class="mono cat">{row.cat}</span>
          </div>
          <p class="mono label">Status / SYS.OK / 18:24:06</p>
          <p class="copy">{copy}</p>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .lead { margin-block: var(--space-2) var(--space-4); }
  .grid { display: grid; gap: var(--space-3); }
  @media (min-width: 64rem) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 100rem) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .panel { container-type: inline-size; display: grid; gap: var(--space-2); align-content: start; padding: var(--space-3); min-inline-size: 0; }
  .name { margin: 0; font: 600 0.875rem / 1.3 var(--font-mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-accent); }
  .note { margin: 0; color: var(--color-muted); font-size: 0.9375rem; }
  .hero { margin: var(--space-2) 0 0; font-family: var(--fd); font-stretch: var(--fw); font-weight: 700; font-size: calc(var(--hs) * 1cqi); line-height: 0.9; letter-spacing: -0.06em; }
  .work { display: grid; grid-template-columns: 2rem 1fr; gap: 0.15rem var(--space-2); align-items: baseline; padding-block: var(--space-2); border-block: 1px solid var(--color-rule); }
  .work .title { font-family: var(--fd); font-stretch: var(--fw); font-weight: 700; font-size: clamp(1.75rem, 8cqi, 3.25rem); line-height: 0.95; letter-spacing: -0.05em; }
  .work .ctx, .work .cat { grid-column: 2; }
  .mono { font-family: var(--fm); font-size: 0.8125rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-muted); }
  .label { margin: 0; }
  .copy { margin: 0; font-family: var(--fb); font-size: 1.0625rem; line-height: 1.55; max-inline-size: 60ch; }
</style>
