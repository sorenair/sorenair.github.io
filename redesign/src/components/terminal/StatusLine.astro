---
/** Mono status readout: system state, current path, live clock and an optional counter. */
interface Props {
  /** Extra readouts, for example a node counter. */
  items?: string[];
}
const { items = [] } = Astro.props;
const path = Astro.url.pathname;
---

<p class="status-line terminal-label">
  <span>SYS.OK</span><span class="sep" aria-hidden="true">/</span>
  <span>{path}</span><span class="sep" aria-hidden="true">/</span>
  <span data-clock>--:--:--</span>
  {items.map((item) => (<><span class="sep" aria-hidden="true">/</span><span>{item}</span></>))}
  <slot />
</p>
