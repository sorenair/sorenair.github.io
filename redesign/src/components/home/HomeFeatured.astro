---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { loadProjectCover } from '../../project-cover';

const featured = await getEntry('projects', 'portal');
const cover = await loadProjectCover(featured.data.cover.src);
---

<section class="featured container" aria-labelledby="featured-title">
  <p class="terminal-label">Featured / 01</p>
  <a class="featured-link" href={`/work/${featured.id}/`}>
    <Image
      src={cover}
      alt={featured.data.cover.alt}
      width={960}
      widths={[480, 720, 960]}
      sizes="(min-width: 56rem) 40vw, 100vw"
    />
    <span class="featured-copy">
      <span class="featured-title" id="featured-title">{featured.data.title}</span>
      <span class="featured-summary">{featured.data.summary}</span>
      <span class="featured-go terminal-label" aria-hidden="true">View project ↗</span>
    </span>
  </a>
</section>

<style>
  .featured {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3) var(--space-5);
  }

  .featured-link {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-2) var(--gutter);
    margin-inline: calc(var(--gutter) * -1);
    border-block: 1px solid var(--color-rule);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--motion-fast) var(--ease-out), color var(--motion-fast) var(--ease-out);
  }

  .featured-link img {
    inline-size: 100%;
    background: var(--color-surface);
  }

  .featured-copy { display: grid; gap: var(--space-1); align-content: center; }

  .featured-title {
    font: 700 clamp(2.5rem, 1rem + 7vw, 7rem) / 0.9 var(--font-display);
    letter-spacing: -0.06em;
  }

  .featured-summary { max-inline-size: 42ch; color: var(--color-muted); font-size: 1.125rem; }

  /* The accent floods the row on focus, press, or hover. */
  .featured-link:is(:focus-visible, :active) {
    background: var(--color-accent);
    color: var(--color-background);
    outline-offset: -3px;
  }
  .featured-link:is(:focus-visible, :active) :is(.featured-summary, .featured-go) { color: var(--color-background); }

  @media (hover: hover) {
    .featured-link:hover { background: var(--color-accent); color: var(--color-background); }
    .featured-link:hover :is(.featured-summary, .featured-go) { color: var(--color-background); }
  }

  @media (min-width: 56rem) {
    .featured-link { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--space-4); }
  }
</style>
