---
import DecodePoster from './DecodePoster.astro';

interface Props {
  autoplay?: boolean;
  background?: boolean;
  decode?: boolean;
  playTriggerId?: string;
}

const { autoplay = false, background = false, decode = false, playTriggerId } = Astro.props;
const hasMask = Astro.slots.has('mask');
const eagerPoster = autoplay || hasMask;
const desktopMedia = '(min-width: 56rem)';
---

<div
  class:list={['reel', { 'reel--background': background }]}
  data-desktop-media={desktopMedia}
  data-autoplay={autoplay ? '' : undefined}
  data-decode={decode ? '' : undefined}
  data-play-trigger-id={playTriggerId}
>
  <picture>
    <source media={desktopMedia} srcset="/home/reel-desktop.webp" width="1280" height="720" />
    <img src="/home/reel-mobile.webp" width="720" height="540" alt="" loading={eagerPoster ? "eager" : "lazy"} fetchpriority={decode ? 'low' : eagerPoster ? 'high' : undefined} />
  </picture>
  <video muted loop playsinline preload="none" aria-hidden="true"></video>
  {decode && <DecodePoster {desktopMedia} />}
  {hasMask && <div class="reel-mask" aria-hidden="true"><slot name="mask" /></div>}
  <button class="reel-control" type="button" hidden>Play reel</button>
</div>

<script>
  const reel = document.querySelector<HTMLElement>('.reel');
  const video = reel?.querySelector('video');
  const control = reel?.querySelector('button');
  const desktopMedia = reel?.dataset.desktopMedia;
  const mask = reel?.querySelector<HTMLElement>('.reel-mask');

  if (reel && video && control && desktopMedia) {
    const desktop = matchMedia(desktopMedia);
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const decode = reel.hasAttribute('data-decode');
    let wantsPlayback = reel.hasAttribute('data-autoplay') && !motion.matches;
    let arrivalTimer: number | undefined;

    const cancelArrival = () => {
      window.clearTimeout(arrivalTimer);
      arrivalTimer = undefined;
    };

    const showPoster = () => {
      reel.removeAttribute('data-playing');
      reel.removeAttribute('data-mask-cleared');
    };

    const playbackFailed = () => {
      wantsPlayback = false;
      cancelArrival();
      showPoster();
      if (mask || decode) reel.setAttribute('data-playback-failed', '');
      control.textContent = mask || decode ? 'Retry reel' : 'Play reel';
    };

    const prepareReel = () => {
      const src = desktop.matches ? '/home/reel-desktop.mp4' : '/home/reel-mobile.mp4';

      if (video.getAttribute('src') !== src) {
        showPoster();
        video.src = src;
        if (decode) video.currentTime = 0.25;
      } else if (video.error) {
        video.load();
        if (decode) video.currentTime = 0.25;
      }
    };

    const playReel = () => {
      cancelArrival();
      prepareReel();
      if (mask && motion.matches) reel.setAttribute('data-mask-cleared', '');

      video.play().catch((error: unknown) => {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        if (wantsPlayback && video.paused) playbackFailed();
      });
    };

    video.addEventListener('playing', () => {
      reel.setAttribute('data-playing', '');
      reel.removeAttribute('data-playback-failed');
      control.textContent = 'Pause reel';
    });
    video.addEventListener('pause', () => {
      if (!reel.hasAttribute('data-playback-failed')) control.textContent = 'Play reel';
    });
    video.addEventListener('error', playbackFailed);
    control.addEventListener('click', () => {
      wantsPlayback = video.paused;
      if (wantsPlayback) {
        playReel();
      } else {
        video.pause();
      }
    });
    const triggerId = reel.dataset.playTriggerId;
    const trigger = triggerId ? document.getElementById(triggerId) : null;
    trigger?.addEventListener('click', (event) => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || !video.paused) return;
      wantsPlayback = true;
      playReel();
    });
    desktop.addEventListener('change', () => {
      if (arrivalTimer !== undefined) prepareReel();
      else if (wantsPlayback) playReel();
      else showPoster();
    });
    motion.addEventListener('change', () => {
      if (motion.matches) {
        cancelArrival();
        wantsPlayback = false;
        video.pause();
        showPoster();
      }
    });

    if (mask) {
      const hover = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
      const clearReveal = () => mask.style.removeProperty('--reel-reveal');

      reel.addEventListener('pointermove', (event) => {
        if (!hover.matches || event.pointerType !== 'mouse' || reel.hasAttribute('data-playing')) return;

        const art = mask.querySelector<HTMLElement>(desktop.matches ? '.desktop' : '.mobile');
        if (!art) return;

        const columns = Number(art.dataset.columns);
        const rows = Number(art.dataset.rows);
        const frame = reel.getBoundingClientRect();
        const column = Math.floor((event.clientX - frame.left) / frame.width * columns);
        const row = Math.floor((event.clientY - frame.top) / frame.height * rows);
        const width = Math.round(columns * 0.12);
        const height = Math.round(rows * 0.16);
        const startColumn = Math.max(0, Math.min(columns - width, column - Math.floor(width / 2)));
        const startRow = Math.max(0, Math.min(rows - height, row - Math.floor(height / 2)));
        const left = `${startColumn / columns * 100}%`;
        const right = `${(startColumn + width) / columns * 100}%`;
        const top = `${startRow / rows * 100}%`;
        const bottom = `${(startRow + height) / rows * 100}%`;

        // The second ring cuts a cell-aligned window out of the outer rectangle.
        mask.style.setProperty('--reel-reveal', `polygon(evenodd, 0 0, 100% 0, 100% 100%, 0 100%, 0 0, ${left} ${top}, ${right} ${top}, ${right} ${bottom}, ${left} ${bottom}, ${left} ${top})`);
      });

      reel.addEventListener('pointerleave', clearReveal);
      hover.addEventListener('change', clearReveal);
      desktop.addEventListener('change', clearReveal);
      video.addEventListener('playing', clearReveal);
      video.addEventListener('error', clearReveal);
    }

    control.hidden = false;
    if (wantsPlayback && decode) {
      video.preload = 'auto';
      prepareReel();
      arrivalTimer = window.setTimeout(playReel, 1000);
    } else if (wantsPlayback) playReel();
  }
</script>

<style>
  .reel {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
  }

  .reel img,
  .reel video {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .reel video {
    visibility: hidden;
  }

  .reel[data-playing] video {
    visibility: visible;
  }

  .reel-mask {
    position: absolute;
    inset: 0;
    pointer-events: none;
    clip-path: var(--reel-reveal, none);
    transition: opacity var(--motion-project) var(--ease-out);
  }

  .reel:is([data-playing], [data-mask-cleared], [data-playback-failed]) .reel-mask {
    opacity: 0;
  }

  .reel[data-mask-cleared] .reel-mask {
    transition-duration: 0ms;
  }

  .reel-control {
    position: absolute;
    inset: auto var(--space-2) var(--space-2) auto;
    min-block-size: var(--tap-target);
    border: 1px solid var(--color-muted);
    padding: var(--space-1) var(--space-2);
    background: var(--color-background);
    color: var(--color-text);
    font: 650 0.9375rem / 1.3 var(--font-body);
    cursor: pointer;
    transition: color var(--motion-fast) var(--ease-out), background-color var(--motion-fast) var(--ease-out);
  }

  .reel--background {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    overflow: hidden;
  }

  .reel--background::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(0deg, #080808f2, #08080875 41%, #08080812 74%),
      linear-gradient(90deg, #080808a6, #08080880 50%, #08080800 85%);
  }

  .reel--background .reel-control {
    inset: var(--space-2) var(--gutter) auto auto;
    z-index: 1;
  }

  @media (min-width: 56rem) {
    .reel:not(.reel--background) {
      aspect-ratio: 16 / 9;
    }
  }

  @media (hover: hover) {
    .reel-control:hover {
      background: var(--color-accent);
      color: var(--color-background);
    }
  }

  .reel-control:active {
    background: var(--color-accent);
    color: var(--color-background);
    transition-duration: 0ms;
  }
</style>
