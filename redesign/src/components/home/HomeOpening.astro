---
import HomeFeatured from './HomeFeatured.astro';
import HomeReel from './HomeReel.astro';

interface Props {
  kineticTitle?: boolean;
}

const { kineticTitle = false } = Astro.props;
const name = 'Soren Gabor';
const titleWords = Array.from(name.matchAll(/\S+/g));
---

<section class="container home-opening" aria-labelledby="home-title">
  <div class="home-intro">
    <h1 class="page-title" id="home-title" aria-label={kineticTitle ? name : undefined}>
      {kineticTitle ? (
        titleWords.map(({ 0: word, index = 0 }, wordIndex) => (
          <>
            {wordIndex > 0 && ' '}
            <span class="typing-word" aria-hidden="true">
              {Array.from(word, (letter, offset) => (
                <span class="typing-letter" style={`--letter-index: ${index + offset}`}><span class="typing-glyph">{letter}</span></span>
              ))}
            </span>
          </>
        ))
      ) : name}
    </h1>
    <p class="lead">I design electronic systems and make creative work across video, music, and games.</p>
    <a class="work-link" href="/work/">View work</a>
  </div>

  <slot name="hero">
    <HomeReel autoplay />
  </slot>

  <HomeFeatured class="home-feature" />
</section>

<style>
  .home-opening {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-3) var(--space-5);
  }

  .home-intro {
    align-self: center;
  }

  .home-intro h1 {
    text-wrap: balance;
  }

  .typing-word {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .typing-letter {
      --typing-interval: 120ms;
      --typing-start: 240ms;
      --letter-start: calc(var(--typing-start) + var(--letter-index) * var(--typing-interval));
      position: relative;
    }

    .typing-glyph {
      display: inline-block;
      animation: type-letter var(--typing-interval) steps(1, end) var(--letter-start) backwards;
    }

    .typing-letter::before,
    .typing-word:last-child .typing-letter:last-child::after {
      content: '';
      position: absolute;
      inset-block-end: 0.09em;
      inline-size: 0.28em;
      block-size: 0.08em;
      background: var(--color-accent);
      opacity: 0;
    }

    .typing-letter::before {
      inset-inline-start: 0;
      animation: typing-caret var(--typing-interval) steps(1, end) var(--letter-start);
    }

    .typing-word:first-child .typing-letter:first-child::before {
      animation-delay: 0ms;
      animation-duration: calc(var(--typing-start) + var(--typing-interval));
    }

    .typing-word:last-child .typing-letter:last-child::after {
      inset-inline-end: 0;
      animation: typing-caret 360ms steps(1, end) calc(var(--letter-start) + var(--typing-interval));
    }

    @keyframes type-letter {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes typing-caret {
      from { opacity: 1; }
      to { opacity: 0; }
    }
  }

  .home-intro p {
    max-inline-size: 29ch;
    margin-block: var(--space-2) var(--space-3);
  }

  .work-link {
    display: inline-flex;
    align-items: center;
    background: var(--color-text);
    color: var(--color-background);
    text-decoration: none;
    min-block-size: var(--tap-target);
    border: 1px solid transparent;
    padding: var(--space-1) var(--space-2);
    font: 650 0.9375rem / 1.3 var(--font-body);
    transition: color var(--motion-fast) var(--ease-out), background-color var(--motion-fast) var(--ease-out);
  }

  @media (min-width: 56rem) {
    .home-opening {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      padding-block-start: var(--space-4);
    }

    .home-intro h1 {
      font-size: clamp(3.75rem, 7vw, 7rem);
    }

    .home-opening > :global(.home-feature) {
      grid-column: 1 / -1;
    }
  }

  @media (hover: hover) {
    .work-link:hover {
      background: var(--color-accent);
      color: var(--color-background);
    }
  }

  .work-link:active {
    background: var(--color-accent);
    color: var(--color-background);
    transition-duration: 0ms;
  }
</style>
