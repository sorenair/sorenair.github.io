---
import HeroDecode from './HeroDecode.astro';
import HomeReel from './HomeReel.astro';
---

<section class="hero bracketed" aria-labelledby="hero-title">
  <HomeReel autoplay background />
  <HeroDecode />
  <div class="grid-layer module-grid" aria-hidden="true"></div>

  <div class="container hero-bar">
    <p class="hero-status terminal-label" role="presentation">
      <span>SYS.OK</span><span class="sep">/</span>
      <span class="loc">LOC 44.98N 93.26W</span><span class="sep loc">/</span>
      <span data-clock>--:--:--</span>
    </p>
  </div>

  <div class="container hero-copy">
    <h1 class="hero-title display-title" id="hero-title">
      <span class="line"><span>Soren</span></span>
      <span class="line"><span>Gabor<i aria-hidden="true">Ø</i></span></span>
    </h1>
    <p class="hero-intro">I design electronic systems and make creative work across video, music, and games.</p>
    <div class="hero-actions">
      <a class="terminal-control work-link" href="/work/">View work</a>
    </div>
  </div>

</section>

<script>
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const tick = () => { clock.textContent = new Date().toLocaleTimeString('en-GB', { timeZone: 'America/Chicago' }); };
    tick();
    window.setInterval(tick, 1000);
  }
</script>

<style>
  .hero {
    /* Lighter grid lines so they read over the footage. */
    --color-rule: #f4f4f140;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr;
    min-block-size: clamp(32rem, 92svh, 64rem);
    background: var(--color-background);
    border-block-end: 1px solid var(--color-rule);
  }

  .hero > :global(.reel) { z-index: 0; }
  .hero > :global(.reel .reel-control) { z-index: 3; }

  .hero > .grid-layer {
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
  }

  .hero-bar {
    position: relative;
    z-index: 2;
    align-self: start;
    padding-block: var(--space-2);
    pointer-events: none;
  }

  .hero-status {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.6em;
    margin: 0;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  .hero-status .sep { opacity: 0.4; }

  @media (max-width: 40rem) {
    .hero-status .loc { display: none; }
    .hero-status { max-inline-size: 11rem; }
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    align-self: end;
    padding-block: var(--space-4);
    pointer-events: none;
  }

  .hero-title {
    margin: 0;
    line-height: 0.84;
    text-shadow: 0 0 2rem #0008;
  }

  .line { display: block; overflow: clip; padding-block-end: 0.06em; }
  .line > span { display: inline-block; }
  .hero-title i { color: var(--color-accent); font-style: normal; margin-inline-start: 0.04em; }

  .hero-intro {
    max-inline-size: 34ch;
    margin: var(--space-3) 0 var(--space-2);
    font-size: clamp(1.0625rem, 0.85rem + 0.9vw, 1.625rem);
    line-height: 1.3;
  }

  .hero-actions { pointer-events: auto; display: flex; gap: var(--space-1); }

  .work-link {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-background);
  }

  .work-link:is(:active, :focus-visible) {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* One clip wipe per line, upward, staggered. */
    .line > span {
      animation: wipe 700ms var(--ease-artifact) both;
    }
    .line:nth-child(2) > span { animation-delay: 120ms; }
    .hero-intro, .hero-actions { animation: rise 600ms var(--ease-out) 380ms both; }
  }

  @keyframes wipe { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes rise { from { opacity: 0; transform: translateY(0.75rem); } to { opacity: 1; transform: none; } }

  @media (hover: hover) {
    .work-link:hover { background: var(--color-accent); border-color: var(--color-accent); }
  }
</style>
