---
import { fileURLToPath } from 'node:url';
import { root } from 'astro:config/server';
import sharp from 'sharp';

const glyphs = ' .:-=+*#%@';
const dither = [-8, 4, 8, -4];

async function renderPoster(view: 'desktop' | 'mobile', columns: number, rows: number) {
  const file = fileURLToPath(new URL(`public/home/reel-${view}.webp`, root));
  const luminance = await sharp(file)
    .resize(columns, rows, { fit: 'fill' })
    .toColourspace('b-w')
    .raw()
    .toBuffer();

  const art = Array.from({ length: rows }, (_, y) =>
    Array.from({ length: columns }, (_, x) => {
      const value = luminance[y * columns + x] + dither[(y % 2) * 2 + (x % 2)];
      const tone = Math.max(0, Math.min(1, (value - 14) / 216));
      return glyphs[Math.round(tone * (glyphs.length - 1))];
    }).join('')
  ).join('\n');

  return { view, columns, rows, art };
}

const posters = await Promise.all([
  renderPoster('mobile', 68, 38),
  renderPoster('desktop', 104, 44),
]);
---

<div class="ascii-poster" aria-hidden="true">
  {posters.map(({ view, columns, rows, art }) => (
    <pre
      class:list={['ascii-art', view]}
      data-columns={columns}
      data-rows={rows}
      style={{ '--columns': columns, '--rows': rows }}
    >{art}</pre>
  ))}
</div>

<style>
  .ascii-poster {
    --height-to-width: 0.75;
    container-type: inline-size;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: inset 0 0 0 1px var(--color-rule);
    border-radius: var(--panel-radius);
  }

  .ascii-art {
    margin: 0;
    font: calc(100cqw / var(--columns) / 0.602) / calc(100cqw * var(--height-to-width) / var(--rows)) Menlo, Consolas, monospace;
    white-space: pre;
    font-variant-ligatures: none;
    user-select: none;
  }

  .desktop {
    display: none;
  }

  @media (min-width: 56rem) {
    .ascii-poster {
      --height-to-width: 0.5625;
      aspect-ratio: 16 / 9;
    }

    .desktop {
      display: block;
    }

    .mobile {
      display: none;
    }
  }
</style>
