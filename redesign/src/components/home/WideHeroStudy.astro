---
import HomeFeatured from './HomeFeatured.astro';
import HomeReel from './HomeReel.astro';

interface Props {
  treatment: 'gradient' | 'reel' | 'decode';
}

const { treatment } = Astro.props;
const gradient = treatment === 'gradient';
---

<section class="wide-hero" aria-labelledby="wide-title">
  {gradient ? (
    <img
      class="gradient-still"
      src="/home/charcoal-gradient.webp"
      srcset="/home/charcoal-gradient-small.webp 800w, /home/charcoal-gradient.webp 1600w"
      sizes="100vw"
      width="1600"
      height="900"
      alt=""
      fetchpriority="high"
    />
  ) : <HomeReel autoplay background decode={treatment === 'decode'} />}

  <div class="container hero-copy">
    <h1 class="page-title" id="wide-title">Soren Gabor</h1>
    <p>I design electronic systems and make creative work across video, music, and games.</p>
    <div class="hero-actions">
      <a class="terminal-control work-link" href="/work/">View work</a>
      {gradient && <a class="terminal-control reel-link" id="watch-home-reel" href="#video-reel">Watch reel</a>}
    </div>
  </div>
</section>

<div class="container study-content">
  {gradient && (
    <section id="video-reel" aria-labelledby="video-reel-title" tabindex="-1">
      <h2 class="section-title" id="video-reel-title">Video reel</h2>
      <HomeReel playTriggerId="watch-home-reel" />
    </section>
  )}
  <HomeFeatured />
</div>

<style>
  .wide-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-block-size: clamp(28rem, 80svh, 62rem);
    background: var(--color-background);
    border-block-end: 1px solid var(--color-rule);
  }

  .gradient-still {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 60% center;
  }

  .hero-copy {
    position: relative;
    color: var(--color-text);
    padding-block: var(--space-5);
    pointer-events: none;
  }

  .hero-copy h1 {
    font-size: clamp(2.75rem, 8.45vw, 9.25rem);
    max-inline-size: 100%;
    text-wrap: balance;
  }

  .hero-copy p {
    max-inline-size: 32ch;
    margin-block: var(--space-2) var(--space-3);
    color: var(--color-text);
    font-size: clamp(1rem, 0.79rem + 0.8vw, 1.5rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .hero-actions a {
    pointer-events: auto;
  }

  .work-link {
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-background);
  }

  .work-link:is(:active, :focus-visible) {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-background);
  }

  .reel-link {
    background: var(--color-background);
  }

  .study-content {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-3) var(--space-5);
  }

  #video-reel {
    display: grid;
    gap: var(--space-2);
    scroll-margin-block-start: var(--space-2);
  }

  #video-reel:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .work-link:hover {
      background: var(--color-accent);
      border-color: var(--color-accent);
      color: var(--color-background);
    }
  }
</style>
