---
// Full-frame glyph field over the hero reel. It starts as scrambling noise, then a diagonal
// wave resolves each cell into a glyph of the footage and finally into the footage itself.
// Decorative only: aria-hidden, no pointer capture, and nothing is drawn for reduced motion.
---

<canvas class="hero-decode" aria-hidden="true" data-hero-decode></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-decode]');
  const hero = canvas?.closest<HTMLElement>('.hero');
  const video = hero?.querySelector<HTMLVideoElement>('.reel video');
  const poster = hero?.querySelector<HTMLImageElement>('.reel picture img');
  const control = hero?.querySelector<HTMLButtonElement>('.reel-control');
  const ctx = canvas?.getContext('2d');
  const motion = matchMedia('(prefers-reduced-motion: no-preference)');

  if (canvas && hero && video && ctx) {
    const ramp = ' .:-=+*#%@';
    const noise = '01Ø/\\|<>[]{}+=:;';
    const sample = document.createElement('canvas');
    const sctx = sample.getContext('2d', { willReadFrequently: true })!;
    const bg = '#121212';
    const accent = () => getComputedStyle(hero).getPropertyValue('--color-accent').trim() || '#ffffff';
    const smooth = (t: number) => { const c = Math.max(0, Math.min(1, t)); return c * c * (3 - 2 * c); };
    const hash = (i: number) => { const s = Math.sin(i * 12.9898) * 43758.5453; return s - Math.floor(s); };

    let cols = 0, rows = 0, cell = 14, cellH = 18, dpr = 1;
    let delay = new Float32Array(0);
    let lum = new Uint8ClampedArray(0);
    let energy = new Float32Array(0);   // cursor trail, 0..1 per cell
    let band = new Float32Array(0);     // held corner band opacity per cell
    let startTime = 0;
    let running = false;
    let done = false;
    let visible = true;
    let pointer: { x: number; y: number } | null = null;
    let raf = 0;
    let lastBand = 0;
    const WAVE = 2200;
    const SETTLE = 520;
    const BAND_MS = 90;                 // the held band refreshes like a terminal, not at 60 fps

    const layout = () => {
      const rect = hero.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      cell = rect.width < 640 ? 11 : 14;
      cellH = Math.round(cell * 1.3);
      cols = Math.ceil(rect.width / cell);
      rows = Math.ceil(rect.height / cellH);
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      sample.width = cols;
      sample.height = rows;
      delay = new Float32Array(cols * rows);
      energy = new Float32Array(cols * rows);
      band = new Float32Array(cols * rows);
      const narrow = rect.width < 640;
      // The held band sits in the bottom-right and fades out toward its top-left edge.
      const bx0 = cols * (narrow ? 0.4 : 0.56);
      const by0 = rows * (narrow ? 0.5 : 0.34);
      for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
        const i = y * cols + x;
        delay[i] = ((x / cols) * 0.62 + (y / rows) * 0.2 + hash(i) * 0.18) * WAVE;
        const u = (x - bx0) / (cols - bx0);
        const v = (y - by0) / (rows - by0);
        band[i] = u > 0 && v > 0 ? smooth(u * 1.6) * smooth(v * 1.6) * 0.85 : 0;
      }
      lum = new Uint8ClampedArray(cols * rows);
    };

    const readLuminance = () => {
      const source = video.readyState >= 2 && video.videoWidth ? video : poster;
      if (!source) return;
      const sw = source instanceof HTMLVideoElement ? source.videoWidth : source.naturalWidth;
      const sh = source instanceof HTMLVideoElement ? source.videoHeight : source.naturalHeight;
      if (!sw || !sh) return;
      const scale = Math.max(cols / sw, rows / sh);
      const dw = sw * scale, dh = sh * scale;
      sctx.drawImage(source, (cols - dw) / 2, (rows - dh) / 2, dw, dh);
      const data = sctx.getImageData(0, 0, cols, rows).data;
      for (let i = 0; i < cols * rows; i++) {
        lum[i] = data[i * 4] * 0.3 + data[i * 4 + 1] * 0.59 + data[i * 4 + 2] * 0.11;
      }
    };

    const glyphFor = (i: number) => ramp[Math.min(ramp.length - 1, Math.floor((lum[i] / 255) * ramp.length))];

    /** Corner band: glyphs of the footage over a soft shade so they read on bright frames. */
    const drawBand = () => {
      const w = canvas.width / dpr, h = canvas.height / dpr;
      const shade = ctx.createRadialGradient(w, h, 0, w, h, Math.max(w, h) * 0.55);
      shade.addColorStop(0, 'rgba(18,18,18,0.55)');
      shade.addColorStop(1, 'rgba(18,18,18,0)');
      ctx.fillStyle = shade;
      ctx.fillRect(0, 0, w, h);
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const i = y * cols + x;
          const a = band[i];
          if (a < 0.03) continue;
          const g = glyphFor(i);
          if (g === ' ') continue;
          const tone = lum[i] / 255;
          ctx.fillStyle = `rgba(244,244,241,${(a * (0.3 + 0.7 * tone)).toFixed(3)})`;
          ctx.fillText(g, x * cell, y * cellH);
        }
      }
    };

    const draw = (now: number) => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.font = `600 ${cell * 1.05}px ui-monospace, Menlo, Consolas, monospace`;
      ctx.textBaseline = 'top';
      const color = accent();

      if (!done) {
        // Decode pass: dark panels and noise ahead of the wave, glyphs on it, clear behind it.
        const elapsed = startTime ? now - startTime : 0;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        readLuminance();
        const tick = Math.floor(now / 90);
        let pending = 0;
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            const i = y * cols + x;
            const phase = startTime ? Math.max(-1, Math.min(1, (elapsed - delay[i]) / SETTLE)) : -1;
            const gx = x * cell, gy = y * cellH;
            if (phase >= 1) continue;
            pending++;
            if (phase < 0) {
              ctx.fillStyle = bg;
              ctx.fillRect(gx, gy, cell + 0.5, cellH + 0.5);
              if (hash(i + tick * 7) > 0.55) {
                ctx.fillStyle = 'rgba(244,244,241,0.22)';
                ctx.fillText(noise[Math.floor(hash(i * 3 + tick) * noise.length)], gx, gy);
              }
              continue;
            }
            const fade = 1 - phase;
            ctx.fillStyle = `rgba(18,18,18,${(0.86 * fade).toFixed(3)})`;
            ctx.fillRect(gx, gy, cell + 0.5, cellH + 0.5);
            ctx.fillStyle = phase < 0.45 ? color : `rgba(244,244,241,${(0.95 * fade).toFixed(3)})`;
            const jitter = phase < 0.3 && hash(i + tick) > 0.6;
            ctx.fillText(jitter ? noise[Math.floor(hash(i + tick * 5) * noise.length)] : glyphFor(i), gx, gy);
          }
        }
        if (startTime && pending === 0) { done = true; lastBand = 0; }
        raf = requestAnimationFrame(draw);
        return;
      }

      // Hold: the corner band stays, refreshing a few times a second while the reel plays.
      let trailing = 0;
      if (pointer) {
        const px = pointer.x / cell, py = pointer.y / cellH, radius = 7;
        const x0 = Math.max(0, Math.floor(px - radius)), x1 = Math.min(cols - 1, Math.ceil(px + radius));
        const y0 = Math.max(0, Math.floor(py - radius)), y1 = Math.min(rows - 1, Math.ceil(py + radius));
        for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) {
          const d = Math.hypot(x - px, (y - py) * 0.75) / radius;
          if (d < 1) energy[y * cols + x] = Math.max(energy[y * cols + x], (1 - d) ** 1.6);
        }
      }
      for (let i = 0; i < energy.length; i++) if (energy[i] > 0.02) trailing++;

      const playing = !video.paused;
      const bandDue = now - lastBand > BAND_MS && (playing || lastBand === 0);
      if (!bandDue && !trailing && !pointer) {
        if (playing && visible) raf = requestAnimationFrame(draw);
        else running = false;
        return;
      }
      if (bandDue) { lastBand = now; readLuminance(); }
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      drawBand();
      if (trailing || pointer) {
        // Cursor trail: bare glyphs whose opacity falls off with distance and fades over time.
        for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
          const i = y * cols + x;
          const e = energy[i];
          if (e <= 0.02) continue;
          const g = glyphFor(i);
          if (g !== ' ') {
            ctx.fillStyle = e > 0.7 ? color : `rgba(244,244,241,${(e * 0.95).toFixed(3)})`;
            ctx.globalAlpha = Math.min(1, e * 1.4);
            ctx.fillText(g, x * cell, y * cellH);
            ctx.globalAlpha = 1;
          }
          energy[i] = e * 0.9;
        }
      }
      if (visible && (playing || pointer || trailing)) raf = requestAnimationFrame(draw);
      else running = false;
    };

    const run = () => {
      if (running || document.hidden || !visible) return;
      running = true;
      raf = requestAnimationFrame(draw);
    };

    const begin = () => {
      if (startTime) return;
      startTime = performance.now();
      done = false;
      run();
    };

    const replay = () => {
      startTime = performance.now();
      done = false;
      run();
    };

    layout();
    new ResizeObserver(() => { layout(); lastBand = 0; if (done) run(); }).observe(hero);

    if (!motion.matches) {
      // Reduced motion: one static still of the corner band, no animation.
      const still = () => {
        done = true;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.font = `600 ${cell * 1.05}px ui-monospace, Menlo, Consolas, monospace`;
        ctx.textBaseline = 'top';
        readLuminance();
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        drawBand();
      };
      if (poster?.complete) still(); else poster?.addEventListener('load', still, { once: true });
    } else {
      run(); // idle noise until the footage is ready
      video.addEventListener('playing', () => window.setTimeout(begin, 700), { once: true });
      window.setTimeout(begin, 3200);
      video.addEventListener('playing', () => { if (done) run(); });
      control?.addEventListener('click', () => { if (video.paused) window.setTimeout(replay, 0); });

      const hover = matchMedia('(hover: hover) and (pointer: fine)');
      hero.addEventListener('pointermove', (event) => {
        if (!hover.matches || event.pointerType !== 'mouse' || !done) return;
        const rect = hero.getBoundingClientRect();
        pointer = { x: event.clientX - rect.left, y: event.clientY - rect.top };
        run();
      });
      hero.addEventListener('pointerleave', () => { pointer = null; });

      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        if (visible) run(); else { cancelAnimationFrame(raf); running = false; }
      }).observe(hero);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) { cancelAnimationFrame(raf); running = false; } else run();
      });
    }
  }
</script>

<style>
  .hero-decode {
    position: absolute;
    inset: 0;
    z-index: 1;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
  }

  /* Without scripting or with reduced motion the canvas never draws and the still shows. */
</style>
