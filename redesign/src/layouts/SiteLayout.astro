---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import mark from '../../../images/o.png';
import { getCoverAccent } from '../cover-accent';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  /** Local artwork under /images/ for the initial page accent. */
  accentSource?: string;
}

const { title, description, accentSource } = Astro.props;
const { pathname } = Astro.url;
const canonical = new URL(pathname, Astro.site);
const workCurrent = pathname === '/work/' ? 'page' : pathname.startsWith('/work/') ? 'location' : undefined;
const project = !accentSource && workCurrent === 'location' && Astro.params.slug
  ? await getEntry('projects', Astro.params.slug)
  : undefined;
const accent = await getCoverAccent(accentSource ?? project?.data.cover.src);
---

<!doctype html>
<html lang="en" style={accent ? { '--color-page-accent': accent } : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121212" />
    <title>{title} | Soren Gabor</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-mark terminal-panel" href="/" aria-label="Soren Gabor, Home" aria-current={pathname === '/' ? 'page' : undefined}>
          <Image src={mark} alt="" width={80} height={80} loading="eager" />
        </a>
        <nav aria-label="Primary">
          <a class="terminal-control" href="/work/" aria-current={workCurrent}>Work</a>
          <a class="terminal-control" href="/media/" aria-current={pathname === '/media/' ? 'page' : undefined}>Media</a>
          <a class="terminal-control" href="/about/" aria-current={pathname === '/about/' ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <span class="terminal-label">Soren Gabor</span>
        <a class="terminal-control" href="/about/#contact">Contact</a>
      </div>
    </footer>
  </body>
</html>
